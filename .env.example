# Binance API Configuration Example
# Copy this file to .env and fill in your actual values

# Binance API Credentials (from GitHub Actions Secrets)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Binance Account Information (from GitHub Actions Variables)
BINANCE_ID_UID=your_binance_uid_here
BINANCE_UID_WALLET=your_wallet_uid_here

# Network Configuration (from GitHub Actions Variables)
BINANCE_API_LIST_IP=your_ip_whitelist_here

# API Configuration
BINANCE_TESTNET=false
BINANCE_BASE_URL=https://api.binance.com

# Database Configuration (Optional)
DATABASE_URL=mysql://root:password@localhost:3306/project_1
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=project_1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
